{
  "fixture": "mechanical-change",
  "domain": "workflow routing",
  "notes": "Routine mechanical work stays cohesive and does not automatically require both review gates.",
  "rubric": {
    "tier": "smoke",
    "hardGates": [
      {
        "id": "normative-plan",
        "check": {
          "type": "output_contains",
          "value": "plan.md"
        }
      },
      {
        "id": "proportional-review",
        "check": {
          "type": "output_matches",
          "regex": "(does not|doesn.t|not required|no mandatory|need not|unnecessary)[\\s\\S]{0,100}(review|both gates)|(review|both gates)[\\s\\S]{0,100}(not required|unnecessary|optional)",
          "flags": "i"
        }
      },
      {
        "id": "no-forced-parallelism",
        "check": {
          "type": "output_matches",
          "regex": "(does not|doesn't|no need to|without).{0,80}(parallel|multiple builder)",
          "flags": "i"
        }
      }
    ]
  }
}
