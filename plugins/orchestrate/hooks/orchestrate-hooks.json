{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/route-spawn.mjs\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "^SendMessage$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/revive-guard.mjs\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
