#!/bin/bash
# Public-boundary scan of everything a push publishes: every commit the remote
# does not already have — its tree AND its message — and any annotated tag's
# message, each checked against the allowlist committed in that same commit.
# A commit hook can be skipped by a human (--no-verify) or predate this gate;
# this is the last local check before the bytes leave the machine.
set -e
top=$(git rev-parse --show-toplevel)
. "$(dirname "$0")/boundary-lib.sh"

checker=$(boundary_checker_dir)
if [ -z "$checker" ]; then
  echo "boundary: bootstrap.boundaryChecker is not configured — push scan skipped" >&2
  exit 0
fi

remote=$1
zero=$(git hash-object --stdin </dev/null | tr '0-9a-f' '0')
work=$(mktemp -d "${TMPDIR:-/tmp}/bootstrap-pre-push.XXXXXX")
cleanup() {
  if [ -d "$work/tree" ]; then git -C "$top" worktree remove --force "$work/tree" >/dev/null 2>&1 || true; fi
  rm -rf "$work"
}
trap cleanup EXIT

cat > "$work/refs"
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue # a ref deletion publishes no content

  if [ "$(git cat-file -t "$local_sha")" = tag ]; then
    git cat-file tag "$local_sha" | sed '1,/^$/d' > "$work/message"
    run_boundary_checker "$checker" --root "$top" --message "$work/message" --message-raw \
      --allowlist "$top/.public-boundary-allowlist.json"
  fi

  if [ "$remote_sha" != "$zero" ] && git cat-file -e "$remote_sha^{commit}" 2>/dev/null; then
    set -- "$remote_sha"
  else
    set --
  fi
  git rev-list "$local_sha" --not "$@" --remotes="$remote" </dev/null > "$work/commits"

  while read -r commit; do
    echo "boundary: scanning $(git rev-parse --short "$commit") for $remote_ref" >&2
    git -C "$top" -c core.hooksPath=/dev/null worktree add --detach --quiet "$work/tree" "$commit" </dev/null
    write_committed_allowlist "$commit:" "$work/allowlist.json"
    git show --no-patch --format=%B "$commit" > "$work/message"
    run_boundary_checker "$checker" --root "$work/tree" --index --allowlist "$work/allowlist.json"
    run_boundary_checker "$checker" --root "$work/tree" --message "$work/message" --message-raw \
      --allowlist "$work/allowlist.json"
    git -C "$top" worktree remove --force "$work/tree" </dev/null
  done < "$work/commits"
done < "$work/refs"
