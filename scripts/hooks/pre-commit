#!/bin/bash
# Bootstrap commit gate (committed; enabled via `git config core.hooksPath scripts/hooks`).
#
#   1. Public-boundary scan of the STAGED tree, against the STAGED allowlist
#      (see boundary-lib.sh). This repository is public.
#   2. Parity drift gate: generated/vendored artifacts stay in sync with their
#      single source (shared guard cores → vendored; Claude skills → substance-
#      gated workflow-agents skills).
#
# Agents cannot skip either: the destructive-command guard refuses --no-verify,
# core.hooksPath overrides and husky skip variables.
set -e
top=$(git rev-parse --show-toplevel)
. "$(dirname "$0")/boundary-lib.sh"

checker=$(boundary_checker_dir) && found=0 || found=$?
if [ "$found" -eq 2 ]; then exit 1; fi
if [ -n "$checker" ]; then
  allowlist=$(mktemp "${TMPDIR:-/tmp}/bootstrap-boundary-allowlist.XXXXXX")
  trap 'rm -f "$allowlist"' EXIT
  write_committed_allowlist ":" "$allowlist"
  run_boundary_checker "$checker" --root "$top" --staged --allowlist "$allowlist"
else
  echo "boundary: bootstrap.boundaryChecker is not configured — public-boundary scan skipped" >&2
fi

node "$top/scripts/check-parity.mjs"
